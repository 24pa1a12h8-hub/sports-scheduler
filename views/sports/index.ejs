<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900">Manage Sports</h1>
      <p class="text-sm text-gray-500 mt-1">Configure available sports categories across the application.</p>
    </div>
    <a href="/admin/dashboard" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg transition">
      &larr; Back to Dashboard
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Form to Create Sport -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm h-fit">
      <div class="flex items-center space-x-2 mb-4">
        <span class="text-2xl">➕</span>
        <h2 class="text-xl font-bold text-gray-900">Add New Sport</h2>
      </div>

      <form action="/admin/sports" method="POST" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700">Sport Name</label>
          <input type="text" id="name" name="name" required placeholder="e.g. Volleyball, Squash"
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-green-500 focus:border-green-500 text-sm">
        </div>

        <button type="submit"
          class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150">
          Create Sport
        </button>
      </form>
    </div>

    <!-- Sports List Table -->
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/50">
        <h2 class="text-lg font-bold text-gray-900">Configured Sports (<%= sports.length %>)</h2>
      </div>

      <% if (sports && sports.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider text-left">
              <tr>
                <th scope="col" class="px-6 py-3">Sport Name</th>
                <th scope="col" class="px-6 py-3">Created By</th>
                <th scope="col" class="px-6 py-3">Total Sessions</th>
                <th scope="col" class="px-6 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
              <% sports.forEach(sport => { %>
                <tr class="hover:bg-gray-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap font-bold text-gray-900 flex items-center space-x-2">
                    <span>🏅</span>
                    <span><%= sport.name %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                    <%= sport.creator ? sport.creator.name : 'System' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      <%= sport.sessions ? sport.sessions.length : 0 %> matches
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <a href="/admin/sports/<%= sport.id %>/edit" class="text-indigo-600 hover:text-indigo-900 font-semibold text-xs bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded transition">
                      Edit Sport
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-8 text-center text-gray-500">
          No sports configured yet. Add your first sport using the form on the left.
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
