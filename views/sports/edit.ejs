<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
    <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-gray-100">
      <span class="text-3xl">✏️</span>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Edit Sport</h1>
        <p class="text-sm text-gray-500">Update sport category title</p>
      </div>
    </div>

    <form action="/admin/sports/<%= sport.id %>/edit" method="POST" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Sport Name</label>
        <input type="text" id="name" name="name" required value="<%= sport.name %>"
          class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500 text-sm">
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-gray-100">
        <a href="/admin/sports" class="text-sm font-medium text-gray-600 hover:text-gray-900">
          &larr; Cancel and Return
        </a>
        <button type="submit"
          class="py-2.5 px-6 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
