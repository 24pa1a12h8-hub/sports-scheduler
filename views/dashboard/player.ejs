<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  <!-- Welcome Banner -->
  <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-6 sm:p-8 text-white shadow-md mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center">
    <div>
      <span class="bg-white/20 text-emerald-100 text-xs uppercase px-2.5 py-0.5 rounded-full font-semibold">Player Portal</span>
      <h1 class="text-3xl font-extrabold mt-2">Welcome back, <%= currentUser.name %>!</h1>
      <p class="text-emerald-100 mt-1">Ready for a game? Join an open match or organize your own session.</p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <a href="/sessions/new" class="bg-white text-emerald-800 font-bold px-4 py-2.5 rounded-lg shadow hover:bg-emerald-50 transition text-sm">
        + Create Match
      </a>
      <a href="/sessions" class="bg-emerald-500 hover:bg-emerald-400 text-white font-semibold px-4 py-2.5 rounded-lg transition text-sm">
        Browse Sessions
      </a>
    </div>
  </div>

  <!-- Two Columns: Joined Sessions & Created Sessions -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Left Column: Sessions You Joined -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100">
          <div class="flex items-center space-x-2">
            <span class="text-2xl">👥</span>
            <h2 class="text-xl font-bold text-gray-900">Matches You Joined</h2>
          </div>
          <a href="/sessions?tab=joined" class="text-xs font-semibold text-green-600 hover:underline">View all &rarr;</a>
        </div>

        <% if (joinedSessions && joinedSessions.length > 0) { %>
          <div class="space-y-4">
            <% joinedSessions.forEach(session => { %>
              <div class="border border-gray-200 rounded-lg p-4 hover:border-green-300 transition duration-150 flex flex-col justify-between bg-gray-50/50">
                <div class="flex justify-between items-start mb-2">
                  <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2 py-0.5 rounded-full">
                    <%= session.sport ? session.sport.name : 'Sport' %>
                  </span>
                  <span class="text-xs text-gray-500">
                    Host: <strong><%= session.creator ? session.creator.name : 'Unknown' %></strong>
                  </span>
                </div>
                <h3 class="font-bold text-gray-900 text-base mb-1"><%= session.venue %></h3>
                <p class="text-xs text-gray-500 mb-3">
                  📅 <%= session.date %> &bull; ⏰ <%= session.time %>
                </p>
                <div class="flex justify-between items-center text-xs">
                  <span class="text-emerald-700 font-medium">✓ Enrolled as Participant</span>
                  <a href="/sessions/<%= session.id %>" class="font-semibold text-green-600 hover:text-green-800">
                    View Details &rarr;
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-200">
            <span class="text-3xl">⚽</span>
            <p class="text-sm text-gray-500 mt-2">You haven't joined any upcoming sessions yet.</p>
            <a href="/sessions" class="mt-3 inline-block text-xs font-bold text-green-600 hover:underline">Browse available matches &rarr;</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Sessions You Created -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100">
          <div class="flex items-center space-x-2">
            <span class="text-2xl">📋</span>
            <h2 class="text-xl font-bold text-gray-900">Matches You Created</h2>
          </div>
          <a href="/sessions?tab=created" class="text-xs font-semibold text-green-600 hover:underline">View all &rarr;</a>
        </div>

        <% if (createdSessions && createdSessions.length > 0) { %>
          <div class="space-y-4">
            <% createdSessions.forEach(session => { %>
              <div class="border border-gray-200 rounded-lg p-4 hover:border-green-300 transition duration-150 flex flex-col justify-between bg-gray-50/50">
                <div class="flex justify-between items-start mb-2">
                  <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-0.5 rounded-full">
                    <%= session.sport ? session.sport.name : 'Sport' %>
                  </span>
                  <span class="text-xs font-medium <%= session.status === 'cancelled' ? 'text-red-600 font-bold' : 'text-green-600' %>">
                    <%= session.status.toUpperCase() %>
                  </span>
                </div>
                <h3 class="font-bold text-gray-900 text-base mb-1"><%= session.venue %></h3>
                <p class="text-xs text-gray-500 mb-3">
                  📅 <%= session.date %> &bull; ⏰ <%= session.time %> &bull; Slots: <%= session.participants ? session.participants.length : 0 %> / <%= session.additionalPlayersNeeded %> filled
                </p>
                <div class="flex justify-between items-center text-xs">
                  <span class="text-gray-500">Organizer: You</span>
                  <a href="/sessions/<%= session.id %>" class="font-semibold text-green-600 hover:text-green-800">
                    Manage Session &rarr;
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-200">
            <span class="text-3xl">🎯</span>
            <p class="text-sm text-gray-500 mt-2">You haven't created any sessions yet.</p>
            <a href="/sessions/new" class="mt-3 inline-block text-xs font-bold text-green-600 hover:underline">+ Host a new session now &rarr;</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
