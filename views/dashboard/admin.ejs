<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
  <!-- Admin Welcome Banner -->
  <div class="bg-gradient-to-r from-purple-800 to-indigo-900 rounded-2xl p-6 sm:p-8 text-white shadow-md mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center">
    <div>
      <span class="bg-white/20 text-purple-200 text-xs uppercase px-2.5 py-0.5 rounded-full font-semibold">Administrator Hub</span>
      <h1 class="text-3xl font-extrabold mt-2">Welcome, <%= currentUser.name %>!</h1>
      <p class="text-purple-200 mt-1">Manage global sports, inspect matches, and track platform engagement reports.</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <a href="/admin/sports" class="bg-white text-purple-900 font-bold px-4 py-2 rounded-lg shadow hover:bg-purple-50 transition text-sm">
        Manage Sports
      </a>
      <a href="/admin/reports" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-2 rounded-lg transition text-sm">
        📊 View Analytics
      </a>
      <a href="/sessions/new" class="bg-purple-700 hover:bg-purple-600 text-white font-semibold px-4 py-2 rounded-lg transition text-sm">
        + Create Session
      </a>
    </div>
  </div>

  <!-- Metric KPI Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <div class="text-xs font-semibold text-gray-500 uppercase">Available Sports</div>
      <div class="text-3xl font-extrabold text-gray-900 mt-1"><%= totalSports %></div>
      <a href="/admin/sports" class="text-xs text-purple-600 hover:underline mt-2 inline-block">Configure sports &rarr;</a>
    </div>
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <div class="text-xs font-semibold text-gray-500 uppercase">Total Sessions</div>
      <div class="text-3xl font-extrabold text-gray-900 mt-1"><%= totalSessions %></div>
      <a href="/sessions" class="text-xs text-purple-600 hover:underline mt-2 inline-block">View all matches &rarr;</a>
    </div>
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <div class="text-xs font-semibold text-gray-500 uppercase">Active Sessions</div>
      <div class="text-3xl font-extrabold text-green-600 mt-1"><%= activeSessions %></div>
      <span class="text-xs text-gray-400 mt-2 inline-block">Status: Scheduled</span>
    </div>
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <div class="text-xs font-semibold text-gray-500 uppercase">Registered Players</div>
      <div class="text-3xl font-extrabold text-indigo-600 mt-1"><%= totalPlayers %></div>
      <span class="text-xs text-gray-400 mt-2 inline-block">Active player accounts</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Sports Created by You Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Sports Created by You</h2>
        <a href="/admin/sports" class="text-xs font-bold text-purple-600 hover:text-purple-800">+ Add / Manage</a>
      </div>

      <% if (sports && sports.length > 0) { %>
        <div class="divide-y divide-gray-100">
          <% sports.forEach(sport => { %>
            <div class="py-3 flex justify-between items-center">
              <div>
                <span class="font-bold text-gray-800"><%= sport.name %></span>
                <span class="text-xs text-gray-400 ml-2">
                  (<%= sport.sessions ? sport.sessions.length : 0 %> matches)
                </span>
              </div>
              <a href="/admin/sports/<%= sport.id %>/edit" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-2.5 py-1 rounded">
                Edit Sport
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-sm text-gray-500 py-4 text-center">No sports created by you yet.</p>
        <div class="text-center">
          <a href="/admin/sports" class="inline-block bg-purple-600 text-white text-xs font-semibold px-4 py-2 rounded-md hover:bg-purple-700">
            Create Your First Sport
          </a>
        </div>
      <% } %>
    </div>

    <!-- Recent Sessions Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Recent Sessions</h2>
        <a href="/sessions" class="text-xs font-bold text-purple-600 hover:text-purple-800">View All</a>
      </div>

      <% if (recentSessions && recentSessions.length > 0) { %>
        <div class="space-y-3">
          <% recentSessions.forEach(session => { %>
            <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-sm text-gray-900"><%= session.sport ? session.sport.name : 'Sport' %></span>
                  <span class="text-xs <%= session.status === 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %> px-2 py-0.5 rounded-full font-medium">
                    <%= session.status %>
                  </span>
                </div>
                <div class="text-xs text-gray-500 mt-1">
                  📅 <%= session.date %> &bull; ⏰ <%= session.time %> &bull; <%= session.venue %>
                </div>
              </div>
              <a href="/sessions/<%= session.id %>" class="text-xs font-semibold text-purple-600 hover:text-purple-800">
                Inspect &rarr;
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-sm text-gray-500 py-4 text-center">No sessions scheduled yet.</p>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
