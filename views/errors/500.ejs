<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 flex-grow text-center">
  <span class="text-6xl">⚠️</span>
  <h1 class="text-4xl font-extrabold text-gray-900 mt-4">Something Went Wrong</h1>
  <p class="text-gray-500 mt-2"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
  <div class="mt-8">
    <a href="/" class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-2.5 rounded-lg shadow transition inline-block">
      Return to Safety
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
